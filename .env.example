# Copy this file to ~/.clipforge/.env, then lock it down (a .env in the directory you start
# shardreel from is also read; ~/.clipforge/.env wins when both set a key):
#   cp .env.example ~/.clipforge/.env && chmod 600 ~/.clipforge/.env
#
# The AI provider is chosen in the UI (job form or Settings). CLIPFORGE_LLM sets the default
# shown before you pick one (none | gemini | openrouter | lmstudio | ollama).
# CLIPFORGE_LLM=

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: fallback model when no model is set in the UI.
# Gemini uses names like gemini-3.8-flash. OpenRouter needs the vendor prefix: google/gemini-3.8-flash.
# CLIPFORGE_LLM_MODEL=

# Optional: any OpenAI-compatible endpoint, e.g. LM Studio.
# CLIPFORGE_LLM_BASE_URL=http://localhost:1234/v1
# CLIPFORGE_LLM_API_KEY=
